# Copy this file to .env and adjust if needed.

# Ollama connection
OLLAMA_HOST=127.0.0.1:11434

# Model used by every agent persona (same model, different system prompts --
# this is the RAM-optimization decision: one model loaded, five roles).
MODEL_NAME=local-code:7b

# Hard ceiling on how many back-and-forth turns the agent group chat can take
# before it is forced to stop. Prevents an unattended dev/security disagreement
# from looping forever and burning CPU all night.
MAX_GROUPCHAT_ROUNDS=30

# How long Ollama keeps the model loaded in RAM after the last request before
# unloading it automatically. Short values free RAM between sessions at the
# cost of a reload delay on the next request.
OLLAMA_KEEP_ALIVE=5m

# Ollama's own concurrency caps -- keep both at 1. This is not optional.
# NUM_PARALLEL=1 means Ollama serves one inference at a time, which matches
# how AutoGen's GroupChat naturally operates (one agent speaks at a time,
# waiting on a response) so there is never real contention. MAX_LOADED_MODELS=1
# guarantees only one model's weights are ever resident in RAM at once, even
# if you later add a second model for a specific agent.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# How many of your logical CPU cores Ollama is allowed to use. Leave some
# free for the OS and everything else running on your machine.
OLLAMA_NUM_THREAD=8

# Hard memory ceiling (MB) applied to the Ollama process via a Windows Job
# Object. This is the actual safeguard against a repeat of the overnight
# resource-runaway incident. Applied to Ollama specifically, never to a
# parent process Ollama could inherit from.
OLLAMA_MAX_MEMORY_MB=10240

# Per-tool-call timeouts (seconds)
SHELL_TIMEOUT_SECONDS=30
TEST_TIMEOUT_SECONDS=120

# Large-deletion guard -- if a file write would remove more than this
# fraction of the file's existing lines, the write is rejected outright
# instead of applied. Ported directly from the AegisCoder project.
DELETION_GUARD_THRESHOLD=0.95

# Max seconds to wait for a single LLM completion before AutoGen gives up.
# Local CPU inference over a growing multi-turn conversation can legitimately
# take a long time -- this must be generous or the run dies mid-phase with
# "OpenAI API call timed out" even though Ollama is still working.
LLM_REQUEST_TIMEOUT_SECONDS=3600

# How many fresh repair cycles a phase gets if it runs out its group-chat
# rounds without finishing. A round limit is a context-window guard, not
# permission to ship unverified code -- this is what lets it try again.
MAX_PHASE_CYCLES=5